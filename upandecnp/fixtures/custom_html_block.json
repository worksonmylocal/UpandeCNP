 {
  "doctype": "Custom HTML Block",
  "name": "UpandeCNP Navigation",
  "html": "<div class=\"cnpn\">\n<div class=\"cnpn-title\">Crop Nutrition Planning</div>\n<div class=\"cnpn-sec\">Dashboards</div>\n<div class=\"cnpn-grid\">\n  <a class=\"cnpn-tile\" href=\"/dashboard\"><span class=\"cnpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Agronomist Dashboard</span><span class=\"cnpn-sub\">Season progress & alerts</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/manager\"><span class=\"cnpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\"/><polyline points=\"17 6 23 6 23 12\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Manager Dashboard</span><span class=\"cnpn-sub\">Budget, cost & coverage</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/field\"><span class=\"cnpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\"/><line x1=\"12\" y1=\"18\" x2=\"12.01\" y2=\"18\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Field App</span><span class=\"cnpn-sub\">Supervisor's mobile page</span></span></a>\n</div>\n<div class=\"cnpn-sec\">Planning</div>\n<div class=\"cnpn-grid\">\n  <a class=\"cnpn-tile\" href=\"/app/fertilizer-programme\"><span class=\"cnpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect x=\"8\" y=\"2\" width=\"8\" height=\"4\" rx=\"1\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Programme</span><span class=\"cnpn-sub\">Build & calculate a season</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/block-fertilizer-plan\"><span class=\"cnpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Block Fertilizer Plan</span><span class=\"cnpn-sub\">Per-block, per-month rounds</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/fertilizer-budget\"><span class=\"cnpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Budget</span><span class=\"cnpn-sub\">Planned vs actual spend</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/production-calendar\"><span class=\"cnpn-ic\" style=\"background:rgba(79,70,229,.13);color:#4f46e5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Production Calendar</span><span class=\"cnpn-sub\">Monthly application schedule</span></span></a>\n</div>\n<div class=\"cnpn-sec\">Field Execution</div>\n<div class=\"cnpn-grid\">\n  <a class=\"cnpn-tile\" href=\"/app/fertilizer-application\"><span class=\"cnpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2.7s6 5.7 6 9.8a6 6 0 0 1-12 0c0-4.1 6-9.8 6-9.8z\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Application</span><span class=\"cnpn-sub\">What was actually applied</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/material-request?custom_fertilizer_programme=%5B%22is%22%2C%22set%22%5D\"><span class=\"cnpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Requests</span><span class=\"cnpn-sub\">Store requests raised by CNP</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/material-request\"><span class=\"cnpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Material Request</span><span class=\"cnpn-sub\">All requests you can see</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/field-attendance\"><span class=\"cnpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Field Attendance</span><span class=\"cnpn-sub\">Applicators present by block</span></span></a>\n</div>\n<div class=\"cnpn-sec\">Reports</div>\n<div class=\"cnpn-grid\">\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Fertilizer%20Programme%20Summary\"><span class=\"cnpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Programme Summary</span><span class=\"cnpn-sub\">Totals by product & month</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Section%20Fertilizer%20Plan\"><span class=\"cnpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Section Fertilizer Plan</span><span class=\"cnpn-sub\">Plan grouped by section</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Monthly%20Fertilizer%20Requirement\"><span class=\"cnpn-ic\" style=\"background:rgba(79,70,229,.13);color:#4f46e5\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Monthly Requirement</span><span class=\"cnpn-sub\">What is needed each month</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Procurement%20Requirement\"><span class=\"cnpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Procurement Requirement</span><span class=\"cnpn-sub\">Shortfall against stock</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Fertilizer%20Job%20Sheet\"><span class=\"cnpn-ic\" style=\"background:rgba(100,116,139,.15);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect x=\"8\" y=\"2\" width=\"8\" height=\"4\" rx=\"1\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Job Sheet</span><span class=\"cnpn-sub\">Printable job sheet</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Application%20Register\"><span class=\"cnpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Application Register</span><span class=\"cnpn-sub\">Every recorded application</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Blocks%20Applied\"><span class=\"cnpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Blocks Applied</span><span class=\"cnpn-sub\">Coverage by block</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Plan%20vs%20Actual%20Application\"><span class=\"cnpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\"/><polyline points=\"17 6 23 6 23 12\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Plan vs Actual</span><span class=\"cnpn-sub\">Planned against applied</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/query-report/Budget%20vs%20Actual%20Cost\"><span class=\"cnpn-ic\" style=\"background:rgba(244,63,94,.13);color:#e11d48\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Budget vs Actual Cost</span><span class=\"cnpn-sub\">Spend against budget</span></span></a>\n</div>\n<div class=\"cnpn-sec\">Master Data</div>\n<div class=\"cnpn-grid\">\n  <a class=\"cnpn-tile\" href=\"/app/cnp-farm\"><span class=\"cnpn-ic\" style=\"background:rgba(100,116,139,.15);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"18\"/><line x1=\"16\" y1=\"6\" x2=\"16\" y2=\"22\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">CNP Farm</span><span class=\"cnpn-sub\">Farms in the module</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/farm-block\"><span class=\"cnpn-ic\" style=\"background:rgba(100,116,139,.15);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Farm Block</span><span class=\"cnpn-sub\">Blocks, area & tree counts</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/section\"><span class=\"cnpn-ic\" style=\"background:rgba(100,116,139,.15);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"18\"/><line x1=\"16\" y1=\"6\" x2=\"16\" y2=\"22\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Section</span><span class=\"cnpn-sub\">Sections within a farm</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/crop\"><span class=\"cnpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.13 1L6 16a2 2 0 0 0 2 2h15\"/><path d=\"M1 6.13L16 6a2 2 0 0 1 2 2v15\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Crop</span><span class=\"cnpn-sub\">Yield tiers & nutrient rules</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/fertilizer-product\"><span class=\"cnpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2v6L4.6 17.4A2 2 0 0 0 6.4 20h11.2a2 2 0 0 0 1.8-2.6L15 8V2\"/><line x1=\"9\" y1=\"2\" x2=\"15\" y2=\"2\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Fertilizer Product</span><span class=\"cnpn-sub\">CAN, MOP, K2SO4, TSP</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/leaf-analysis\"><span class=\"cnpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Leaf Analysis</span><span class=\"cnpn-sub\">Lab results per section</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/leaf-analysis-norm\"><span class=\"cnpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Leaf Analysis Norm</span><span class=\"cnpn-sub\">Target ranges by nutrient</span></span></a>\n  <a class=\"cnpn-tile\" href=\"/app/crop-nutrition-planning-settings\"><span class=\"cnpn-ic\" style=\"background:rgba(100,116,139,.15);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10.6 3V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"cnpn-tx\"><span class=\"cnpn-lb\">Settings</span><span class=\"cnpn-sub\">Module-wide defaults</span></span></a>\n</div>\n</div>",
  "style": ".cnpn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.cnpn-title{font-size:15px;font-weight:700;color:var(--heading-color,#1f272e);margin:0 0 14px 2px;}\n.cnpn-sec{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:20px 0 10px 2px;}\n.cnpn-sec:first-of-type{margin-top:4px;}\n.cnpn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}\n.cnpn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease;}\n.cnpn-tile:hover{box-shadow:0 2px 6px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none;}\n.cnpn-tile:hover .cnpn-lb,.cnpn-tile:hover .cnpn-sub{text-decoration:none;}\n.cnpn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;color:inherit;}\n.cnpn-ic svg{width:18px;height:18px;}\n.cnpn-tx{min-width:0;display:flex;flex-direction:column;}\n.cnpn-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.cnpn-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}\n.cnpn-hide{display:none !important;}",
  "script": "(function() {\n  try {\n    if (!document.querySelector('link[data-cnp-poppins]')) {\n      var pf=document.createElement('link'); pf.rel='stylesheet'; pf.setAttribute('data-cnp-poppins','1');\n      pf.href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch(e){}\n})();"
 }
]